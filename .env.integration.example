# Integration test credentials — copy to .env.integration and fill in values.
# .env.integration is gitignored; NEVER commit real secrets.
#
# All tests target the dedicated app: com.shipitswifty.integration
# This app exists solely for testing and is never published to end users.
#
# Usage:
#   cp .env.integration.example .env.integration
#   # Fill in your values, then:
#   source .env.integration && swift test --filter IntegrationTests

# ── Apple App Store Connect ────────────────────────────────────────────────────
# Create an API key at: App Store Connect → Users and Access → Integrations → Keys
# Role required: App Manager
# Use the dedicated integration Apple Developer account (ask a maintainer for access).
# Do NOT use your personal or production developer account.
export ASC_KEY_ID=
export ASC_ISSUER_ID=
export ASC_PRIVATE_KEY=""          # paste raw PEM content here
# export ASC_PRIVATE_KEY_PATH=     # or set a path to the .p8 file instead

# ── Google Play ───────────────────────────────────────────────────────────────
# The service account JSON is scoped to com.shipitswifty.integration only.
# Request access from a maintainer — it cannot reach any other Play apps.
export GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=   # path to service-account.json

# ── Optional overrides ────────────────────────────────────────────────────────
# Override the shipit binary path (defaults to .build/debug/shipit)
# export SHIPIT_BINARY_PATH=
