#!/usr/bin/env sh
# ShipItSwifty integration test fixture — Gradle wrapper bootstrap script.
#
# This thin script delegates to the system `gradle` command so the fixture
# works without committing a binary `gradle-wrapper.jar`.
#
# To use the full Gradle wrapper instead (recommended for CI):
#   gradle wrapper --gradle-version 8.7
# That generates gradle-wrapper.jar, after which this script is superseded.
#
# Prerequisites:
#   brew install gradle   # macOS
#   sdk install gradle    # sdkman

set -e

# If a real wrapper jar exists (generated by `gradle wrapper`), use it.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar"

if [ -f "$WRAPPER_JAR" ]; then
    exec java -jar "$WRAPPER_JAR" "$@"
fi

# Fall back to system gradle.
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

echo "Error: 'gradle' not found and gradle-wrapper.jar is missing." >&2
echo "Install Gradle: brew install gradle" >&2
echo "Or generate the wrapper: gradle wrapper --gradle-version 8.7" >&2
exit 1
