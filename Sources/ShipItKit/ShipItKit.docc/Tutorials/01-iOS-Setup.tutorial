@Tutorial(time: 5) {
    @Intro(title: "Set up your iOS Shipfile") {
        Create a `Shipfile.yml` and verify ShipItSwifty can resolve your project.

        @Image(source: tutorial-ios-setup.png, alt: "iOS setup")
    }

    @Section(title: "Install the CLI") {
        @ContentAndMedia {
            Build `shipit` from source and put it on your PATH.
        }

        @Steps {
            @Step {
                Clone the repository and build a release binary.

                @Code(name: "Terminal", file: 01-install.sh)
            }

            @Step {
                Confirm the binary is on your PATH.

                @Code(name: "Terminal", file: 01-verify.sh)
            }
        }
    }

    @Section(title: "Create a Shipfile") {
        @ContentAndMedia {
            Either let `shipit init` write one for you or copy the example.
        }

        @Steps {
            @Step {
                Run `shipit init` from your project root. It will inspect your
                Xcode project and generate a Shipfile populated with what it can
                detect.

                @Code(name: "Terminal", file: 02-init.sh)
            }

            @Step {
                Open the generated `Shipfile.yml`. The `app` block should
                contain your workspace, scheme, bundle ID, and team ID.

                @Code(name: "Shipfile.yml", file: 02-shipfile.yml)
            }

            @Step {
                Verify the resolved configuration.

                @Code(name: "Terminal", file: 02-env.sh)
            }
        }
    }

    @Section(title: "Set ASC credentials (optional)") {
        @ContentAndMedia {
            For local builds you can skip this step. For uploads, configure App
            Store Connect API credentials.
        }

        @Steps {
            @Step {
                Export the three required environment variables.

                @Code(name: "~/.zshrc", file: 03-asc-env.sh)
            }

            @Step {
                Re-run `shipit env` and confirm the credentials show as
                configured (values are masked).

                @Code(name: "Terminal", file: 03-env-verify.sh)
            }
        }
    }
}
